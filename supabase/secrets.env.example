# Copy to secrets.env (ignored). Fill privately; never use EXPO_PUBLIC_ for these values.
FIREBASE_PROJECT_ID=achadidos-15d82
EXPO_PROJECT_ID=ad3b0b7d-22ee-412d-bc1b-0d68a6f29cc5
# One-line JSON for a Google service account with roles/datastore.viewer on this Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Two different random secrets, each at least 32 characters. Keep the session secret stable.
PUSH_SESSION_SECRET=
PUSH_WORKER_SECRET=
# Optional: required only when Expo enhanced push security is enabled.
EXPO_ACCESS_TOKEN=
