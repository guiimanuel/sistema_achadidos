{
  "expo": {
    "name": "system_achadidos",
    "slug": "achadidos",
    "owner": "guiimanuel",
    "icon": "./src/assets/icons/icone.png",
    "version": "1.0.2",
    "backgroundColor": "#059600",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "package": "com.company.achadidos",
      "googleServicesFile": "./android/app/google-services.json",
      "icon": "./src/assets/icons/mural-caixa.png",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.systemachadidos",
      "infoPlist": {
        "NSCameraUsageDescription": "Permita que o Achados e Perdidos use a câmera para fotografar itens encontrados ou perdidos.",
        "NSPhotoLibraryUsageDescription": "Permita que o Achados e Perdidos acesse suas fotos para anexar imagens às publicações."
      },
      "googleServicesFile": "./ios/GoogleService-Info.plist"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o Achados e Perdidos use a câmera para fotografar itens encontrados ou perdidos.",
          "photosPermission": "Permita que o Achados e Perdidos acesse suas fotos para anexar imagens às publicações.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Achados e Perdidos use a câmera para fotografar itens.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "novos-itens"
        }
      ],
      "react-native-nitro-google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "ad3b0b7d-22ee-412d-bc1b-0d68a6f29cc5"
      }
    }
  }
}
